# ──────────────────────────────────────────────────────────────────────────────
# klaUS-aicalc-roi — variables de entorno locales
# Copiar este fichero a .env y ajustar los valores:
#   cp .env.example .env
# .env está en .gitignore — nunca se commitea.
# ──────────────────────────────────────────────────────────────────────────────

# URL de la API FastAPI — visible desde el NAVEGADOR (no desde dentro del contenedor)
# El navegador llama a esta URL directamente desde el host, no a través de la red
# interna de Podman. Debe apuntar al puerto mapeado en el host.
#
# localhost (defecto — acceso solo desde el mismo Mac):
NEXT_PUBLIC_API_URL=http://localhost:8000
#
# IP de red local (acceso desde otros dispositivos en la misma red):
# NEXT_PUBLIC_API_URL=http://192.168.1.127:8000
